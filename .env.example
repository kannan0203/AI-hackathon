# BizInsight AI Environment Variables
# Copy this file to .env and fill in your values

# Google Gemini API Key (get it free at https://aistudio.google.com/app/apikey)
# Leave empty to run in Demo Mode (app still fully works without it)
GOOGLE_API_KEY=your_google_api_key_here

# Backend Configuration
BACKEND_HOST=localhost
BACKEND_PORT=8000

# Frontend API URL (for Vercel deployment, set to your Render backend URL)
VITE_API_URL=http://localhost:8000

# CORS: comma-separated list of allowed origins (for production deployment)
# ALLOWED_ORIGINS=https://your-app.vercel.app
